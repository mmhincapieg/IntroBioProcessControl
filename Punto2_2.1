derivada de L [m/s]\n","    y = y+dydt*dt\n","    \n","    e=y-ysp\n","    y_all[i]= y\n","    y_sp[i]= ysp\n","    \n","    #Control modelo no lineal\n","    u= kpPID*e+kiPID*b+kd*(e_dif[i]-e_dif[i-1])/dt\n","    \n","    if ulin<0:\n","       ulin = 0\n","       if ulin>100:\n","         ulin = 100\n","       if u<0:\n","          u = 0\n","       if u>100:\n","          u = 100\n","\n","    u_dif[i]= u\n","    e_dif[i]= e\n","\n","## Gráfica\n","plt.figure(1)  #Grafica resultados\n","plt.subplot(311)\n","plt.title(\"Tanque con flujo por gravedad con Parametros de curva\", loc='center')\n","plt.plot(t, y_all , 'b-', label='No lineal')\n","plt.plot(t, y_sp , 'm--', label='Ysp')\n","plt.ylabel('Nivel [m]')\n","plt.legend(loc='best') #ubicación de la leyenda donde sea pertinente\n","plt.grid(True)  #Activa cuadrícula del gráfico\n","\n","plt.subplot(312)    \n","plt.plot(t, u_dif , 'r-', label='Ap Válvula No Lin')\n","plt.ylabel('Apertura [%]')\n","# plt.xlabel('Tiempo [s]')\n","plt.legend(loc='best') #ubicación de la leyenda donde sea pertinente\n","plt.grid(True)  #Activa cuadrícula del gráfico\n","\n","plt.subplot(313)    \n","plt.plot(t, e_dif , 'g-', label='Error No lineal')\n","plt.xlabel('Tiempo [s]')\n","plt.ylabel('Error')\n","plt.legend(loc='best') #ubicación de la leyenda donde sea pertinente\n","plt.grid(True)  #Activa cuadrícula del gráfico"],"metadata":{"id":"5bRfPpJThthX"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Control PID modelo No lineal con parametros sacados de la funcion de transferencia"],"metadata":{"id":"O2gmyO6giriB"}},{"cell_type":"code","source":["# importar librerias analítica\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","#Parametro\n","A = 5 \t\t\t\t\t\t# Area del tanque [m^2]\n","g = 9.81\t\t\t\t\t# Gravedad [m/s^2]\n","Cv = 0.0005 \t\t\t\t# Coeficiente de flujo [m^2]\n","v1 = 0.1\t\t\t\t\t# Flujo de entrada del tanque [m^3/s]\n","h = 3\t\t\t\t\t\t# Altura del tanque [m]\n","\n","## Vector tiempo\n","t_o = 0 \t\t\t\t    \t# Tiemo incial [s]\n","t_f = 3000    \t\t\t    \t# Tiempo final [s]\n","dt = 0.01 \t\t\t     \t    # Paso [s] - cada cuanto tiempo se calcula un punto\n","iteraciones = round(t_f/dt)     #Cantidad de iteraciones o puntos a calcular\n","t=np.linspace(t_o,t_f,(iteraciones+1)) #(tiempo inicial, tiempo final,)\n","\n","# Condiciones iniciales\n","pvo = 50\n","yo =  1\n","\n","#Parametros de Control\n","u =pvo     # Porcentaje de apertura de la válvula en la salida del tanque [%]\n","y = yo      # Nivel del tanque [m]\n","d = v1     # Flujo de entrada del tanque [m^3/s]\n","ysp=2.4\n","\n","u_dif=np.zeros(iteraciones+1)\n","y_all=np.zeros(iteraciones+1)\n","\n","y_sp=np.zeros(iteraciones+1)\n","\n","e_dif=np.zeros(iteraciones+1)\n","\n","\n","\n","#Parametro de la función de transferencia\n","tao=1/0.00613127            #[s] \n","ku=-0.0004/0.00613127   #[m/% ]  \n","\n","#Controlador PID\n","kpPID= 0.6*ku \n","kiPID= (1.2*ku/tao)\n","kd=(3*ku*(tao)/40)\n","\n","b=0\n","for i in range(0, iteraciones+1):\n","         \n","    #Ecuación constitutiva\n","    v2 = u * Cv * np.sqrt(g*y)  # Flujo de salida del tanque [m^3/s]\n","    \n","    #Ecuación diferencial\n","    dydt = (d/A) -(v2/A)       # Calcula la derivada de L [m/s]\n","    y = y+dydt*dt\n","    \n","    e=y-ysp\n","    y_all[i]= y\n","    y_sp[i]= ysp\n","     \n","    #Control modelo no lineal\n","    u= kpPID*e+kiPID*b+kd*(e_dif[i]-e_dif[i-1])/dt\n","  \n","    u_dif[i]= u\n","    e_dif[i]= e\n","\n","## Gráfica\n","plt.figure(1)  #Grafica resultados\n","plt.subplot(311)\n","plt.title(\"Tanque con flujo por gravedad con Parametros de la función\", loc='center')\n","plt.plot(t, y_all , 'b-', label='No lineal')\n","plt.plot(t, y_sp , 'm--', label='Ysp')\n","plt.ylabel('Nivel [m]')\n","plt.legend(loc='best') #ubicación de la leyenda donde sea pertinente\n","plt.grid(True)  #Activa cuadrícula del gráfico\n","\n","plt.subplot(312)    \n","plt.plot(t, u_dif , 'r-', label='Ap Válvula No Lin')\n","plt.ylabel('Apertura [%]')\n","# plt.xlabel('Tiempo [s]')\n","plt.legend(loc='best') #ubicación de la leyenda donde sea pertinente\n","plt.grid(True)  #Activa cuadrícula del gráfico\n","\n","plt.subplot(313)    \n","plt.plot(t, e_dif , 'g-', label='Error No lineal')\n","plt.xlabel('Tiempo [s]')\n","plt.ylabel('Error')\n","plt.legend(loc='best') #ubicación de la leyenda donde sea pertinente\n","plt.grid(True)  #Activa cuadrícula del gráfico"],"metadata":{"id":"XVW-ehini-D-"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Curva de reacción"],"metadata":{"id":"0I2k-HM-6yzp"}},{"cell_type":"code","source":["\n","# importar librerias analítica\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","#Parametro\n","A = 5 \t\t\t\t\t\t# Area del tanque [m^2]\n","g = 9.81\t\t\t\t\t# Gravedad [m/s^2]\n","Cv = 0.0005 \t\t\t\t# Coeficiente de flujo [m^2]\n","v1 = 0.1\t\t\t\t\t# Flujo de entrada del tanque [m^3/s]\n","h = 3\t\t\t\t\t\t# Altura del tanque [m]\n","\n","## Vector tiempo\n","t_o = 0 \t\t\t\t    \t# Tiemo incial [s]\n","t_f = 3000    \t\t\t    \t# Tiempo final [s]\n","dt = 0.01 \t\t\t     \t    # Paso [s] - cada cuanto tiempo se calcula un punto\n","iteraciones = round(t_f/dt)     #Cantidad de iteraciones o puntos a calcular\n","t=np.linspace(t_o,t_f,(iteraciones+1)) #(tiempo inicial, tiempo final,)\n","\n","# Condiciones iniciales\n","pvo = 50\n","yo =  1\n","\n","#Parametros de Control\n","u =pvo     # Porcentaje de apertura de la válvula en la salida del tanque [%]\n","y = yo      # Nivel del tanque [m]\n","d = v1     # Flujo de entrada del tanque [m^3/s]\n","ysp=2.4\n","\n","u_dif=np.zeros(iteraciones+1)\n","y_all=np.zeros(iteraciones+1)\n","y_sp=np.zeros(iteraciones+1)\n","\n","e_dif=np.zeros(iteraciones+1)\n","\n","#Parametro de la curva de reacción\n","tao=56.17       #[s] \n","ku=-0.0049809   #[m/% ]  \n","\n","#Controlador PID\n","kpPID= 0.6*ku \n","kiPID= (1.2*ku/tao)\n","kd=(3*ku*(tao)/40)\n","\n","b=0\n","b2=0\n","for i in range(0, iteraciones+1):\n","    #curva de reacción\n","    if t[i]<1500:\n","      u=50\n","    else:\n","      u=60\n","\n","    #Ecuación constitutiva\n","    v2 = u * Cv * np.sqrt(g*y)  # Flujo de salida del tanque [m^3/s]\n","    \n","    #Ecuación diferencial\n","    dydt = (d/A) -(v2/A)       # Calcula la derivada de L [m/s]\n","    y = y+dydt*dt\n","        \n","    e=y-ysp\n","    y_all[i]= y\n","  \n","    u_dif[i]= u\n","    e_dif[i]= e\n","\n","## Gráfica\n","plt.figure(1,figsize=[8,4]) #Grafica resultados\n","plt.subplot(211)\n","plt.title(\"Tanque con flujo por gravedad\", loc='center')\n","plt.plot(t, y_all ,color='gold', label='Mod.Nivel tanque')\n","plt.ylabel('Nivel [m]')\n","plt.legend(loc='best') #ubicación de la leyenda donde sea pertinente\n","plt.grid(True)  #Activa cuadrícula del gráfico\n","\n","plt.subplot(212)    \n","plt.plot(t, u_dif ,color='magenta', label='Ap Válvula')\n","plt.ylabel('Apertura [%]')\n","plt.xlabel('Tiempo [s]')\n","plt.legend(loc='best') #ubicación de la leyenda donde sea pertinente\n","plt.grid(True)  #Activa cuadrícula del gráfico    \n"],"metadata":{"id":"xPlGiqn3617h"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Linealizacion (valores)"],"metadata":{"id":"z75yW9mUbg0e"}},{"cell_type":"code","source":["# importar librerias analítica\n","import numpy as np  #Libreria con muchas funciones :v\n","import sympy as sp  #Libreria para variables simbolicas\n","from scipy import signal #Librerioa para espacios de estados y transformadas\n","\n","sp.init_printing()\n","L,pv,v1=sp.symbols(['L','pv','v1'])\n","\n","#Parametro\n","A = 5    \t\t# Area del tanque [m^2]\n","g = 9.81 \t\t# Gravedad [m/s^2]\n","Cv = 0.0005  \t# Coeficiente de flujo [m^2]\n","\n","# v1 = 0.1\t    # Flujo de entrada del tanque [m^3/s]\n","# h = 3\t\t\t# Altura del tanque [m]\n","\n","# # #Variables en simbolico\n","# L =sp.Symbol('L')\n","# pv =sp.Symbol('pv')\n","# v1 =sp.Symbol('v1')\n","   \n","#Ecuación constitutiva y diferencial\n","v2 = pv * Cv *(g*L)**(1/2)  # Flujo de salida del tanque [m^3/s]\n","dLdt= (v1/A) -(v2/A)        # Calcula la derivada de L [m/s]\n","\n","print('dLdt,L= ', sp.diff(dLdt,L))\n","print('dLdt,pv= ', sp.diff(dLdt,pv))\n","print('dLdt,v1= ', sp.diff(dLdt,v1))\n","\n","# #Puntos de Linealización -Estado estacionario (ees) del modelo no lineal\n","L_ees = 1.63098 # Nivel en el tanque [m] - Salida (y)\n","pv_ees = 50     # Porcentaje de apertura de la válvula (0-1) - Entrada (u)\n","v1_ees = 0.1    # Flujo de entrada al tanque [m^3/s] - Perturbación (d)\n","\n","# #Derivas parciales\n","diff1 = dLdt.diff(L).subs(pv,pv_ees).subs(v1,v1_ees).subs(L,L_ees)\n","diff2 = dLdt.diff(pv).subs(L,L_ees).subs(v1,v1_ees).subs(pv,pv_ees)\n","diff3 = dLdt.diff(v1).subs(L,L_ees).subs(pv,pv_ees).subs(v1,v1_ees)\n","\n","# #Para obtener valores propios\n","A = np.array([[diff1]], dtype=float) #Matriz de estados\n","B = np.array([[diff2, diff3]], dtype=float) \n","C = np.array([[1]], dtype=float) \n","D = np.array([[0,0]], dtype=float) \n","\n","TF = signal.ss2tf(A,B,C,D)\n","\n","print(' ')\n","print('Espacios de Estados:')\n","print('A', A); print('B',B); print('C',C); print('D',D)\n","print(' ')\n","print('Función de transferencia del espacio de estados: ', TF)"],"metadata":{"id":"C3BxSCsoQwsR"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":[""],"metadata":{"id":"YQf-_a4w4GI3"}}]}