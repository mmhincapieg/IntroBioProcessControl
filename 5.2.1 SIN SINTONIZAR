ncia"],"metadata":{"id":"47pLlizpmTxS"}},{"cell_type":"code","source":["# importar librerias analítica\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","#Parametro\n","A = 5 \t\t\t\t\t\t# Area del tanque [m^2]\n","g = 9.81\t\t\t\t\t# Gravedad [m/s^2]\n","Cv = 0.0005 \t\t\t\t# Coeficiente de flujo [m^2]\n","v1 = 0.1\t\t\t\t\t# Flujo de entrada del tanque [m^3/s]\n","h = 3\t\t\t\t\t\t# Altura del tanque [m]\n","\n","## Vector tiempo\n","t_o = 0 \t\t\t\t    \t# Tiemo incial [s]\n","t_f = 3000    \t\t\t    \t# Tiempo final [s]\n","dt = 0.01 \t\t\t     \t    # Paso [s] - cada cuanto tiempo se calcula un punto\n","iteraciones = round(t_f/dt)     #Cantidad de iteraciones o puntos a calcular\n","t=np.linspace(t_o,t_f,(iteraciones+1)) #(tiempo inicial, tiempo final,)\n","\n","# Condiciones iniciales\n","pvo = 50\n","yo =  1\n","\n","#Parametros de Control\n","u =pvo     # Porcentaje de apertura de la válvula en la salida del tanque [%]\n","y = yo      # Nivel del tanque [m]\n","d = v1     # Flujo de entrada del tanque [m^3/s]\n","ysp=2.4\n","\n","u_dif=np.zeros(iteraciones+1)\n","y_all=np.zeros(iteraciones+1)\n","\n","y_sp=np.zeros(iteraciones+1)\n","\n","e_dif=np.zeros(iteraciones+1)\n","\n","\n","\n","#Parametro de la función de transferencia\n","tao=1/0.00613127            #[s] \n","ku=-0.0004/0.00613127   #[m/% ]  \n","\n","#Controlador PID\n","kpPID= 0.6*ku \n","kiPID= (1.2*ku/tao)\n","kd=(3*ku*(tao)/40)\n","\n","b=0\n","for i in range(0, iteraciones+1):\n","         \n","    #Ecuación constitutiva\n","    v2 = u * Cv * np.sqrt(g*y)  # Flujo de salida del tanque [m^3/s]\n","    \n","    #Ecuación diferencial\n","    dydt = (d/A) -(v2/A)       # Calcula la derivada de L [m/s]\n","    y = y+dydt*dt\n","    \n","    e=y-ysp\n","    y_all[i]= y\n","    y_sp[i]= ysp\n","     \n","    #Control modelo no lineal\n","    u= kpPID*e+kiPID*b+kd*(e_dif[i]-e_dif[i-1])/dt\n","    if u<0:\n","      u = 0\n","    if u>100:\n","      u = 100 \n","    \n","    u_dif[i]= u\n","    e_dif[i]= e\n","\n","## Gráfica\n","plt.figure(1)  #Grafica resultados\n","plt.subplot(311)\n","plt.title(\"Tanque con flujo por gravedad con Parametros de la función\", loc='center')\n","plt.plot(t, y_all , 'b-', label='No lineal')\n","plt.plot(t, y_sp , 'm--', label='Ysp')\n","plt.ylabel('Nivel [m]')\n","plt.legend(loc='best') #ubicación de la leyenda donde sea pertinente\n","plt.grid(True)  #Activa cuadrícula del gráfico\n","\n","plt.subplot(312)    \n","plt.plot(t, u_dif , 'r-', label='Ap Válvula No Lin')\n","plt.ylabel('Apertura [%]')\n","# plt.xlabel('Tiempo [s]')\n","plt.legend(loc='best') #ubicación de la leyenda donde sea pertinente\n","plt.grid(True)  #Activa cuadrícula del gráfico\n","\n","plt.subplot(313)    \n","plt.plot(t, e_dif , 'g-', label='Error No lineal')\n","plt.xlabel('Tiempo [s]')\n","plt.ylabel('Error')\n","plt.legend(loc='best') #ubicación de la leyenda donde sea pertinente\n","plt.grid(True)  #Activa cuadrícula del gráfico"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":295},"id":"cm65lM1JmVas","executionInfo":{"status":"ok","timestamp":1644197147135,"user_tz":300,"elapsed":4243,"user":{"displayName":"Isabela Gonzalez Agamez","photoUrl":"https://lh3.googleusercontent.com/a-/AOh14GgyYoReIn7Iknd6n0kNYr-JGYO91SH-2mhic6ggpQ=s64","userId":"03025414909710082940"}},"outputId":"eecb1946-8b40-4d90-db1c-df528fc7bd97"},"execution_count":10,"outputs":[{"output_type":"display_data","data":{"image/png":"\n","text/plain":["<Figure size 432x288 with 3 Axes>"]},"metadata":{"needs_background":"light"}}]},{"cell_type":"markdown","source":["Control PID **MODELO LINEAL** Con parametos de Curva de reaccion"],"metadata":{"id":"z4kf8fJGmg84"}},{"cell_type":"code","source":["# importar librerias analítica\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","#Parametro\n","A = 5 \t\t\t\t\t\t# Area del tanque [m^2]\n","g = 9.81\t\t\t\t\t# Gravedad [m/s^2]\n","Cv = 0.0005 \t\t\t\t# Coeficiente de flujo [m^2]\n","v1 = 0.1\t\t\t\t\t# Flujo de entrada del tanque [m^3/s]\n","h = 3\t\t\t\t\t\t# Altura del tanque [m]\n","\n","## Vector tiempo\n","t_o = 0 \t\t\t\t    \t# Tiemo incial [s]\n","t_f = 3000    \t\t\t    \t# Tiempo final [s]\n","dt = 0.01 \t\t\t     \t    # Paso [s] - cada cuanto tiempo se calcula un punto\n","iteraciones = round(t_f/dt)     #Cantidad de iteraciones o puntos a calcular\n","t=np.linspace(t_o,t_f,(iteraciones+1)) #(tiempo inicial, tiempo final,)\n","\n","# Condiciones iniciales\n","pvo = 50\n","yo =  1\n","\n","#Parametros de Control\n","d = v1     # Flujo de entrada del tanque [m^3/s]\n","ysp=2.4\n","\n","#Parametros linealización\n","ylin=yo\n","ulin=pvo\n","\n","y_lin=np.zeros(iteraciones+1)\n","u_lin=np.zeros(iteraciones+1)\n","y_sp=np.zeros(iteraciones+1)\n","e2_dif=np.zeros(iteraciones+1)\n","\n","#Parametro de la curva de reacción\n","tao=56.17       #[s] \n","ku=-0.0049809   #[m/% ]  \n","\n","#Controlador PID\n","kpPID= 0.6*ku \n","kiPID= (1.2*ku/tao)\n","kd=(3*ku*(tao)/40)\n","\n","b2=0\n","for i in range(0, iteraciones+1):\n","         \n","    #Ecuación ocnstitutiva\n","    v2 = u * Cv * np.sqrt(g*y)  # Flujo de salida del tanque [m^3/s]\n","        \n","    #Ecuación linealizada\n","    dyldt=0.004339540237 -0.0078302298816829*(ylin-yo)-0.000313209195267317*(ulin-pvo)+(1/5)*(d-v1) #Serie de Taylor\n","    ylin=ylin+dyldt*dt\n","    \n","    e2=ylin-ysp\n","    y_lin[i]= ylin\n","    y_sp[i]= ysp\n","    \n","    #Control modelo lineal\n","    ulin= kpPID*e2+kiPID*b2+kd*(e2_dif[i]-e2_dif[i-1])/dt\n","    if ulin<0:\n","      ulin = 0\n","    if ulin>100:\n","      ulin = 100 \n","\n","    u_lin[i]= ulin\n","    e2_dif[i]= e2\n","\n","## Gráfica\n","plt.figure(1)  #Grafica resultados\n","plt.subplot(311)\n","plt.title(\"Tanque con flujo por gravedad\", loc='center')\n","plt.plot(t, y_lin , 'c-', label='Lineal')\n","plt.plot(t, y_sp , 'm--', label='Ysp')\n","plt.ylabel('Nivel [m]')\n","plt.legend(loc='best') #ubicación de la leyenda donde sea pertinente\