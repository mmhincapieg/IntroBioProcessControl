 = (1/(Tao**2))*(d-y+Ku*u-2*dseta*Tao*z)\n","  z = z + dzdt*dt   \n","  y = y + dydt*dt \n","\n","  y_e[i] = y\n","\n","  error = (ysp-y)\n","  error_e[i] = error\n","  sum = sum + (error_e[i]*dt)\n","\n","  u = (Kp*error)+((Kp/Taoi)*sum)+(Kp*Taod*((error-error_e[i-1])/dt))\n","\n","  if u < 0:\n","    u = 0\n","  \n","  u_e[i] = u\n","  d_e[i] = d\n","\n","print(u_e)\n","\n","plt.figure(1, figsize = [7,9]) \n","plt.subplot(411)\n","plt.plot(t, y_e , 'r-', label='Presión de salida (y)', linewidth=2)\n","plt.plot(t, ysp_e, 'c--', label='Ysp', linewidth=1)\n","plt.title(\"Control PID de Presion Oleoducto submarino\")\n","#plt.xlabel('Tiempo [s]')\n","plt.ylabel('Presión psig]')\n","plt.legend(loc='best') #ubicación de la leyenda donde sea pertinente\n","plt.grid(True)\n","\n","#plt.figure(2)\n","plt.subplot(412)\n","plt.plot(t,u_e, 'b-', label='Apertura válvula de entrada (u)')\n","#plt.plot(t,d_e, 'm-', label='Apertura válvula de salida (d)')\n","#plt.title(\"Cambio de Presión válvula\")\n","plt.ylabel(\"Flujo\")\n","#plt.xlabel('Tiempo [s]')\n","plt.tight_layout()     #No se solapen las gráficas\n","plt.legend(loc='best') #ubicación de la leyenda donde sea pertinente\n","plt.grid(True)\n","\n","\n","\n","\n","\n","\n"]},{"cell_type":"code","source":["plt.subplot(413)\n","plt.plot(t,d_e, 'm-', label='Perturbación (d)')\n","#plt.title(\"Cambio de Presión válvula\")\n","plt.ylabel(\"Perturbación\")\n","#plt.xlabel('Tiempo [s]')\n","plt.tight_layout()     #No se solapen las gráficas\n","plt.legend(loc='best') #ubicación de la leyenda donde sea pertinente\n","plt.grid(True)\n","\n","#plt.figure(3)\n","plt.subplot(414)\n","plt.plot(t,error_e, 'g-', label=\"Error\")\n","#plt.title(\"Error Tanque pulmón\")\n","plt.xlabel('Tiempo [s]')\n","plt.ylabel(\"Error [psig]\")\n","plt.legend(loc='best') #ubicación de la leyenda donde sea pertinente\n","plt.grid(True) "],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":190},"id":"vNBE-MDpy-Iz","executionInfo":{"statu